# Server-side only: the Fastify API base URL (including the version prefix).
API_URL=http://localhost:5050/api/v1
# Should match the backend JWT_REFRESH_EXPIRES_IN (seconds). Default 7 days.
REFRESH_COOKIE_MAX_AGE=604800
NEXT_PUBLIC_APP_NAME=Ragama Opticians HRM
# multi | single. Must match the backend TENANCY_MODE.
NEXT_PUBLIC_TENANCY_MODE=multi
