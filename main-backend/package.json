{
  "name": "backend-boilerplate",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Fastify + TypeScript + PostgreSQL (Knex) backend boilerplate",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:rollback": "tsx scripts/db.ts rollback",
    "db:status": "tsx scripts/db.ts status",
    "db:seed": "tsx scripts/db.ts seed",
    "db:make": "tsx scripts/db.ts make",
    "create:org": "tsx scripts/create-org.ts",
    "db:migrate:prod": "node dist/scripts/db.js migrate",
    "audit": "npm audit --omit=dev",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@simplewebauthn/server": "^14.0.3",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "minio": "^8.0.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
