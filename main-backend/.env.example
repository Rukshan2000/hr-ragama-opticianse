NODE_ENV=development
HOST=0.0.0.0
PORT=5000
API_PREFIX=/api/v1

APP_NAME=Invoteam HRM
APP_URL=http://localhost:5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_db
DB_USER=postgres
DB_PASSWORD=password
DB_SSL=false
DB_POOL_MIN=0
DB_POOL_MAX=10

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_EXPIRES_IN=30m

# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000
# Set true only behind a reverse proxy you control (Nginx), so req.ip uses X-Forwarded-For
TRUST_PROXY=false
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Defaults to enabled outside production
# SWAGGER_ENABLED=true

LOG_LEVEL=debug

# multi = SaaS (each signup creates an organization); single = one built-in tenant for the whole app
TENANCY_MODE=multi
DEFAULT_TENANT_NAME=Default
DEFAULT_TENANT_SLUG=default

# Passkeys (WebAuthn). RP_ID = your domain (no scheme/port); EXPECTED_ORIGIN = the frontend origin(s)
# the browser runs on, comma-separated. Must be https in production. RP_NAME defaults to APP_NAME.
# RP_NAME=My Application
RP_ID=localhost
EXPECTED_ORIGIN=http://localhost:3000
PASSKEY_CHALLENGE_TTL=300
PASSKEY_USER_VERIFICATION=required

# MFA. Key that encrypts TOTP secrets (defaults to a key derived from JWT_REFRESH_SECRET).
# Changing it invalidates every enrolled authenticator app.
# MFA_ENCRYPTION_KEY=
MFA_TOKEN_TTL=600

# MinIO (private file storage). Leave MINIO_ENDPOINT unset to use an in-memory store (tests).
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=hr-ragama-opticians
UPLOAD_MAX_BYTES=10485760

# Accounting (Invobiz) integration. Unset = off. Secret = HR_PAYROLL_SECRET in accounting.
# ACCOUNTING_API_URL=http://<accounting-api-host>:<port>/api/v1  (the backend directly, not the web proxy)
# ACCOUNTING_SHARED_SECRET=
